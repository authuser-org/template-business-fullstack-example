	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@repo/typescript-config": "workspace:*",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^10.0.3",
